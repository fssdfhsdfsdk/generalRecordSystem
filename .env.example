# Copy this file to .env and fill in your own values.
# .env is ignored by git and must never be committed.
#
# Priority: real environment variables > .env > built-in defaults.
# Command-line flags (--token, --proxy, ...) still win over both.

# GitHub Fine-grained PAT with "Contents: Read and write" on the target repo.
GRS_GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Optional: publish to a different repository (default: origin remote).
# GRS_GITHUB_REPO=owner/name

# Optional: HTTP(S) proxy. urllib does not support socks5:// addresses.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# GRS_PROXY=http://127.0.0.1:7890

# Optional: trust a proxy/corporate CA bundle (PEM).
# SSL_CERT_FILE=C:\path\to\proxy-ca.pem
# On Windows, Git's Mozilla CA bundle often fixes
# "unable to get issuer certificate" when GitHub is reached through a proxy:
# SSL_CERT_FILE=C:\Program Files\Git\mingw64\ssl\certs\ca-bundle.crt

# Optional: allow uploading to a public repository (dangerous).
# The installed pre-push hook already passes --allow-public.
# GRS_ALLOW_PUBLIC_DATA_RELEASE=1

# Optional: disable TLS verification. Troubleshooting only.
# GRS_INSECURE=1
